+    /// Accumulates byte counters across the consecutive model requests in a turn.
+    model_transfer: ModelTransferAccumulator,
+}
+
+/// Sums per-request byte counters so the status row reports whole-turn volume.
+///
+/// A single sampling turn issues several upstream requests (tool calls loop back
+/// through the model). Bytes from finished requests are folded into `completed_*`
+/// when the next `Sending` phase starts.
+#[derive(Debug, Default)]
+struct ModelTransferAccumulator {
+    phase: Option<ModelTransferPhase>,
+    completed_sent_bytes: u64,
+    completed_received_bytes: u64,
+    request_sent_bytes: u64,
+    request_received_bytes: u64,
+}
+
+impl ModelTransferAccumulator {
+    fn update(
+        &mut self,
+        phase: ModelTransferPhase,
+        request_sent_bytes: u64,
+        request_received_bytes: u64,
+    ) -> ModelTransferStatus {
+        match phase {
+            ModelTransferPhase::Sending => {
+                // A fresh request is starting: bank whatever the previous one used.
+                if self.phase.is_some() {
+                    self.completed_sent_bytes = self
+                        .completed_sent_bytes
+                        .saturating_add(self.request_sent_bytes);
+                    self.completed_received_bytes = self
+                        .completed_received_bytes
+                        .saturating_add(self.request_received_bytes);
+                }
+                self.request_sent_bytes = 0;
+                self.request_received_bytes = 0;
+            }
+            ModelTransferPhase::Receiving => {
+                self.request_sent_bytes = request_sent_bytes;
+                self.request_received_bytes = request_received_bytes;
+            }
+        }
+        self.phase = Some(phase);
+        ModelTransferStatus {
+            phase,
+            sent_bytes: self
+                .completed_sent_bytes
+                .saturating_add(self.request_sent_bytes),
+            received_bytes: self
+                .completed_received_bytes
+                .saturating_add(self.request_received_bytes),
+        }
+    }
 }
 
