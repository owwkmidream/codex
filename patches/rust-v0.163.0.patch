+/// Rebuild the editable prompt for a rendered user cell.
+///
+/// Used where a rollback must restore exactly the prompt that anchors it: deriving both from one
+/// cell keeps the composer text and the reverted range from disagreeing.
+pub(crate) fn user_message_from_history_cell(selected: &UserHistoryCell) -> UserMessage {
+    let local_images = selected
+        .local_image_paths
+        .iter()
+        .enumerate()
+        .map(|(index, path)| LocalImageAttachment {
+            placeholder: local_image_label_text(index + 1),
+            path: path.clone(),
         })
+        .collect();
+
+    UserMessage {
+        text: selected.message.clone(),
+        local_images,
+        remote_image_urls: selected.remote_image_urls.clone(),
+        text_elements: selected.text_elements.clone(),
+        mention_bindings: Vec::new(),
     }
 }
 
