+            info.to_api_provider(None).unwrap().retry.retry_delay_ms,
+            None
+        );
+        assert!(
+            !toml::to_string(&ModelProviderInfo {
+                retry_delay_ms: Some(millis),
+                ..info
+            })
+            .unwrap()
+            .contains("retry_delay_ms")
+        );
+    }
+    assert_eq!(defaults.request_max_retries(), DEFAULT_REQUEST_MAX_RETRIES);
+    assert_eq!(defaults.stream_max_retries(), DEFAULT_STREAM_MAX_RETRIES);
+    for retries in [0, 1001, 999_999, 1_000_000] {
+        let info = ModelProviderInfo {
+            request_max_retries: Some(retries),
+            stream_max_retries: Some(retries),
+            ..Default::default()
+        };
+        assert_eq!(info.request_max_retries(), retries);
+        assert_eq!(info.stream_max_retries(), retries);
+    }
+}
