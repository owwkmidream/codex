+#[test]
+fn space_starts_selection_then_quotes_in_select_mode() {
+    let cells = vec![cell(&["abc"])];
+    let mut view = TranscriptView::default();
+    render(&mut view, &cells);
+    assert!(view.begin_select_mode(&cells));
+    press(&mut view, &cells, KeyCode::Char(' '));
+    assert!(
+        matches!(view.handle_key(KeyCode::Char(' ').into(), &cells), Some(ViewAction::Quote(text)) if text == "a")
+    );
+    let position = view.position;
+    view.end_select_mode();
+    assert_eq!(view.position, position);
+    assert!(view.selection.is_none());
+}
