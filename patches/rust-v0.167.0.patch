+use std::path::Path;
+
+#[derive(Clone, Debug)]
+pub(crate) enum CustomRetryEdit {
+    DelayMode(RetryDelayMode),
+    DelayMillis(u64),
+    StreamRetries {
+        provider_id: String,
+        count: Option<u64>,
+    },
+}
+
+pub(crate) const STREAM_RETRY_UNAVAILABLE: &str =
+    "Use a custom provider to edit stream retries; built-in providers use Default";
+
+pub(crate) fn stream_retries_editable(provider_id: &str) -> bool {
+    // 与上游内置目录保持一致，避免写出下次启动无法加载的 provider 配置。
+    !codex_model_provider_info::built_in_model_providers(None).contains_key(provider_id)
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct CustomRetryStatus {
+    pub(crate) delay: CustomRetrySettings,
+    pub(crate) provider_id: String,
+    pub(crate) stream_retries: Option<u64>,
+}
+
+impl CustomRetryStatus {
+    pub(crate) fn load(home: &Path, config_path: &Path, provider_id: &str) -> io::Result<Self> {
+        let source = match std::fs::read_to_string(config_path) {
+            Ok(source) => source,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => String::new(),
+            Err(error) => return Err(error),
+        };
+        let config: toml::Value = toml::from_str(&source).map_err(io::Error::other)?;
+        let stream_retries = config
+            .get("model_providers")
+            .and_then(|providers| providers.get(provider_id))
+            .and_then(|provider| provider.get("stream_max_retries"))
+            .map(|value| value.clone().try_into().map_err(io::Error::other))
+            .transpose()?;
+        Ok(Self {
+            delay: CustomRetrySettings::load(home)?,
+            provider_id: provider_id.to_string(),
+            stream_retries,
+        })
+    }
+}
+
+pub(crate) fn delay_modes(state: &CustomRetryStatus, keymap: &ListKeymap) -> SelectionViewParams {
+    SelectionViewParams {
+        title: Some("Retry delay mode".into()),
+        subtitle: Some("All providers · saved automatically · applies next turn".into()),
+        footer_hint: Some(picker_hint_line_for_keymap(keymap)),
+        allow_input_when_disconnected: true,
+        initial_selected_idx: Some(match state.delay.retry_delay_mode {
+            RetryDelayMode::Default => 0,
+            RetryDelayMode::Capped => 1,
+            RetryDelayMode::Fixed => 2,
+        }),
+        items: [
+            (
+                "Default",
+                "Use the original waiting strategy",
+                RetryDelayMode::Default,
+            ),
+            (
+                "Capped",
+                "Limit every retry wait to the configured milliseconds",
+                RetryDelayMode::Capped,
+            ),
+            (
+                "Fixed",
+                "Always wait the configured milliseconds",
+                RetryDelayMode::Fixed,
+            ),
+        ]
+        .into_iter()
+        .map(|(name, description, mode)| SelectionItem {
+            name: name.into(),
+            description: Some(description.into()),
+            is_current: mode == state.delay.retry_delay_mode,
+            dismiss_on_select: true,
+            actions: vec![Box::new(move |tx| {
+                tx.send(AppEvent::SaveCustomRetry(CustomRetryEdit::DelayMode(mode)))
+            })],
+            ..Default::default()
+        })
+        .collect(),
+        ..SelectionViewParams::picker()
+    }
+}
+
+pub(crate) struct RetryNumberEditor {
+    editor: ConfigEditor,
+    state: CustomRetryStatus,
+    input: String,
+    error: Option<String>,
+    complete: bool,
+    tx: AppEventSender,
+}
+
+impl RetryNumberEditor {
+    pub(crate) fn new(editor: ConfigEditor, state: CustomRetryStatus, tx: AppEventSender) -> Self {
+        let input = if editor == ConfigEditor::StreamRetries {
+            state
+                .stream_retries
+                .map(|count| count.to_string())
+                .unwrap_or_default()
+        } else {
+            state.delay.retry_delay_ms.to_string()
+        };
+        Self {
+            editor,
+            state,
+            input,
+            error: None,
+            complete: false,
+            tx,
+        }
+    }
+
+    fn accept(&mut self) {
+        let stream = self.editor == ConfigEditor::StreamRetries;
+        let count = if stream && self.input.is_empty() {
+            None
+        } else {
+            let maximum = if stream { 1_000_000 } else { i64::MAX as u64 };
+            match self.input.parse::<u64>() {
+                Ok(value) if value <= maximum => Some(value),
+                _ => {
+                    self.error = Some(format!("Enter a whole number from 0 to {maximum}"));
+                    return;
+                }
+            }
+        };
+        // 空值只用于恢复官方次数默认值；Delay 保持非负数输入。
+        let edit = if stream {
+            CustomRetryEdit::StreamRetries {
+                provider_id: self.state.provider_id.clone(),
+                count,
+            }
+        } else {
+            CustomRetryEdit::DelayMillis(count.expect("delay requires a number"))
+        };
+        self.tx.send(AppEvent::SaveCustomRetry(edit));
+        self.complete = true;
+    }
+}
+
+impl BottomPaneView for RetryNumberEditor {
+    fn handle_key_event(&mut self, key: KeyEvent) {
+        if key.kind == KeyEventKind::Release {
+            return;
+        }
+        self.error = None;
+        match key.code {
+            KeyCode::Esc => self.complete = true,
+            KeyCode::Enter => self.accept(),
+            KeyCode::Backspace => {
+                self.input.pop();
+            }
+            KeyCode::Char('u') if key.modifiers.contains(KeyModifiers::CONTROL) => {
+                self.input.clear()
+            }
+            KeyCode::Char(ch)
+                if ch.is_ascii_digit() && key.modifiers.is_empty() && self.input.len() < 20 =>
+            {
+                self.input.push(ch)
+            }
+            _ => {}
+        }
+    }
+
+    fn handle_paste(&mut self, text: String) -> bool {
+        let text = text.trim();
+        if text.len() <= 20 && text.chars().all(|ch| ch.is_ascii_digit()) {
+            self.input = text.to_string();
+            self.error = None;
+        } else {
+            self.error = Some("Enter nonnegative whole numbers only".into());
+        }
+        true
+    }
+
+    fn is_complete(&self) -> bool {
+        self.complete
+    }
+    fn accepts_input_when_disconnected(&self) -> bool {
+        true
+    }
+    fn on_ctrl_c(&mut self) -> CancellationEvent {
+        self.complete = true;
+        CancellationEvent::Handled
+    }
+}
+
+impl Renderable for RetryNumberEditor {
+    fn desired_height(&self, _width: u16) -> u16 {
+        6
+    }
+
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        let stream = self.editor == ConfigEditor::StreamRetries;
+        let title = if stream {
+            format!("Stream Max Retry · {}", self.state.provider_id)
+        } else {
+            "Retry delay (ms) · all providers".into()
+        };
+        Paragraph::new(vec![
+            Line::from(title),
+            Line::from(if stream {
+                "0–1,000,000 · empty = Default"
+            } else {
+                "Nonnegative milliseconds · 0 = immediate"
+            }),
+            Line::from(format!("> {}▏", self.input)),
+            Line::from(
+                self.error
+                    .clone()
+                    .unwrap_or_else(|| "Applies next turn".into()),
+            ),
+            Line::from("Enter save · Esc cancel · Ctrl+U clear"),
+        ])
+        .render(area, buf);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tokio::sync::mpsc::unbounded_channel;
+
+    #[test]
+    fn stream_editor_validates_bounds_and_default() {
+        let (tx, mut rx) = unbounded_channel();
+        let state = CustomRetryStatus {
+            delay: CustomRetrySettings::default(),
+            provider_id: "retry-test".into(),
+            stream_retries: Some(5),
+        };
+        let mut editor =
+            RetryNumberEditor::new(ConfigEditor::StreamRetries, state, AppEventSender::new(tx));
+        editor.input = "1000001".into();
+        editor.accept();
+        assert!(!editor.complete);
+        assert!(rx.try_recv().is_err());
+        editor.input.clear();
+        editor.accept();
+        assert!(matches!(
+            rx.try_recv().unwrap(),
+            AppEvent::SaveCustomRetry(CustomRetryEdit::StreamRetries { count: None, .. })
+        ));
+    }
+}
