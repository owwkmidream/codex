+        composer.attach_image(std::path::PathBuf::from("photo.png"));
+        composer.handle_paste("z".repeat(LARGE_PASTE_CHAR_THRESHOLD + 1));
+        composer.draft.textarea.set_cursor(0);
+        composer.insert_str("前文");
+        composer.popups.active = ActivePopup::None;
+        if replace_mode {
+            composer.set_vim_enabled(/*enabled*/ true);
+            composer.handle_key_event(KeyCode::Esc.into());
+            composer.handle_key_event(KeyCode::Char('R').into());
+        }
+        composer.draft.textarea.set_cursor("前文".len());
+        let before = composer.draft_snapshot();
+        let expanded = composer.current_text_with_pending();
+        composer.insert_transcript_quote("\n> 引用\n");
+        let after = composer.draft_snapshot();
+        assert_eq!(after.local_images, before.local_images);
+        assert_eq!(after.mention_bindings, before.mention_bindings);
+        assert_eq!(after.pending_pastes, before.pending_pastes);
+        assert_eq!(after.cursor, "前文\n> 引用\n".len());
+        assert_eq!(
+            composer.current_text_with_pending(),
+            expanded.replacen("前文", "前文\n> 引用\n\n", 1)
+        );
+        // 后方三类原子元素整体移动，提交展开仍保留其原始负载。
+        let shift = "\n> 引用\n\n".len();
+        let mut expected_elements = before.text_elements;
+        for element in &mut expected_elements {
+            element.byte_range.start += shift;
+            element.byte_range.end += shift;
+        }
+        assert_eq!(after.text_elements, expected_elements);
+        assert_eq!(after.text_elements.len(), 3);
+    }
