diff --git a/codex-rs/core/src/custom_retry.rs b/codex-rs/core/src/custom_retry.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f10506e8c1fead6819057876a4a7bb7b2fe33041
--- /dev/null
+++ b/codex-rs/core/src/custom_retry.rs
@@ -0,0 +1,224 @@
+//! Patch preferences kept outside the official config.toml schema.
+
+use crate::config::Config;
+use codex_model_provider_info::ModelProviderInfo;
+use serde::Deserialize;
+use serde::Serialize;
+use std::io;
+use std::path::Path;
+
+#[derive(Clone, Copy, Debug, Default, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum RetryDelayMode {
+    #[default]
+    Default,
+    Capped,
+    Fixed,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(default)]
+pub struct CustomRetrySettings {
+    pub retry_delay_mode: RetryDelayMode,
+    pub retry_delay_ms: u64,
+}
+
+impl Default for CustomRetrySettings {
+    fn default() -> Self {
+        Self {
+            retry_delay_mode: RetryDelayMode::Default,
+            retry_delay_ms: 10_000,
+        }
+    }
+}
+
+impl CustomRetrySettings {
+    pub fn load(codex_home: &Path) -> io::Result<Self> {
+        let source = match std::fs::read_to_string(codex_home.join("custom.toml")) {
+            Ok(source) => source,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(Self::default()),
+            Err(error) => return Err(error),
+        };
+        let settings: Self = toml::from_str(&source).map_err(io::Error::other)?;
+        settings.validate()?;
+        Ok(settings)
+    }
+
+    pub fn validate(self) -> io::Result<()> {
+        if self.retry_delay_ms > i64::MAX as u64 {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "Delay must be between 0 and 9223372036854775807 ms",
+            ));
+        }
+        Ok(())
+    }
+
+    pub fn signed_delay(self) -> Option<i64> {
+        match self.retry_delay_mode {
+            RetryDelayMode::Default => None,
+            RetryDelayMode::Capped => Some(self.retry_delay_ms as i64),
+            RetryDelayMode::Fixed => Some(-(self.retry_delay_ms as i64)),
+        }
+    }
+}
+
+/// 每轮固定一次快照；当前轮等待期间的保存只影响下一轮。
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct TurnRetrySettings {
+    pub(crate) delay_ms: Option<i64>,
+    pub(crate) stream_max_retries: u64,
+}
+
+impl TurnRetrySettings {
+    pub(crate) fn load(config: &Config, provider: &ModelProviderInfo) -> Self {
+        let delay_ms = match CustomRetrySettings::load(config.codex_home.as_path()) {
+            Ok(settings) => settings.signed_delay(),
+            Err(error) => {
+                tracing::warn!(%error, "Could not read custom.toml; using default retry timing");
+                None
+            }
+        };
+        Self {
+            // 此字段仅供内部构造方使用，已禁止从 provider TOML 反序列化。
+            delay_ms: delay_ms.or(provider.retry_delay_ms),
+            stream_max_retries: refreshed_stream_retries(config, provider).unwrap_or_else(|error| {
+                tracing::warn!(%error, "Could not refresh stream_max_retries; retaining session config");
+                provider.stream_max_retries()
+            }),
+        }
+    }
+}
+
+fn refreshed_stream_retries(config: &Config, provider: &ModelProviderInfo) -> io::Result<u64> {
+    let stack = &config.config_layer_stack;
+    let Some(path) = stack.get_user_config_file() else {
+        return Ok(provider.stream_max_retries());
+    };
+    let source = match std::fs::read_to_string(path.as_path()) {
+        Ok(source) => source,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => String::new(),
+        Err(error) => return Err(error),
+    };
+    let updated =
+        stack.with_user_config(path, toml::from_str(&source).map_err(io::Error::other)?)?;
+    let original = stack.effective_config();
+    let refreshed = updated.effective_config();
+    let count = |value: &toml::Value| {
+        value
+            .get("model_providers")
+            .and_then(|providers| providers.get(&config.model_provider_id))
+            .and_then(|provider| provider.get("stream_max_retries"))
+            .cloned()
+    };
+    if count(&original) == count(&refreshed) {
+        return Ok(provider.stream_max_retries());
+    }
+    // 只刷新官方字段，合并仍由官方配置层完成，不引入额外优先级。
+    let mut info = provider.clone();
+    info.stream_max_retries = count(&refreshed)
+        .map(|value| value.try_into().map_err(io::Error::other))
+        .transpose()?;
+    Ok(info.stream_max_retries())
+}
+
+impl crate::session::turn_context::TurnContext {
+    pub(crate) fn retry_settings(&self) -> TurnRetrySettings {
+        self.extension_data
+            .get::<TurnRetrySettings>()
+            .map(|settings| *settings)
+            .unwrap_or_else(|| TurnRetrySettings::load(&self.config, self.provider.info()))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn saves_take_effect_next_turn_and_default_restores_official_count() -> anyhow::Result<()>
+    {
+        use crate::config::ConfigBuilder;
+        use crate::config::ConfigOverrides;
+        use crate::config::LoaderOverrides;
+
+        let home = tempfile::tempdir()?;
+        let path = home.path().join("config.toml");
+        // 内置 provider 禁止覆盖次数；使用可被官方配置加载器接受的自定义 provider。
+        let provider_config = "model_provider = 'retry-test'\n[model_providers.retry-test]\nname = 'Retry test'\nbase_url = 'https://example.test/v1'\nwire_api = 'responses'\n";
+        std::fs::write(&path, format!("{provider_config}stream_max_retries = 2\n"))?;
+        let config = ConfigBuilder::default()
+            .codex_home(home.path().to_path_buf())
+            .harness_overrides(ConfigOverrides {
+                cwd: Some(home.path().to_path_buf()),
+                ..Default::default()
+            })
+            .loader_overrides(LoaderOverrides::without_managed_config_for_tests())
+            .build()
+            .await?;
+        let first = TurnRetrySettings::load(&config, &config.model_provider);
+        assert_eq!(first.stream_max_retries, 2);
+        assert_eq!(first.delay_ms, None);
+
+        std::fs::write(
+            home.path().join("custom.toml"),
+            "retry_delay_mode = 'fixed'\nretry_delay_ms = 25\n",
+        )?;
+        std::fs::write(&path, format!("{provider_config}stream_max_retries = 0\n"))?;
+        let next = TurnRetrySettings::load(&config, &config.model_provider);
+        assert_eq!(next.delay_ms, Some(-25));
+        assert_eq!(next.stream_max_retries, 0);
+        assert_eq!(first.delay_ms, None);
+        assert_eq!(first.stream_max_retries, 2);
+
+        std::fs::write(&path, provider_config)?;
+        let reset = TurnRetrySettings::load(&config, &config.model_provider);
+        assert_eq!(
+            reset.stream_max_retries,
+            ModelProviderInfo::default().stream_max_retries()
+        );
+        let mut other_provider = config.model_provider.clone();
+        other_provider.name = "another provider".into();
+        assert_eq!(
+            TurnRetrySettings::load(&config, &other_provider).delay_ms,
+            next.delay_ms
+        );
+        Ok(())
+    }
+
+    #[test]
+    fn independent_file_supports_all_delay_modes_and_zero() -> io::Result<()> {
+        let home = tempfile::tempdir()?;
+        assert_eq!(
+            CustomRetrySettings::load(home.path())?,
+            CustomRetrySettings::default()
+        );
+        for (mode, millis, expected) in [
+            (RetryDelayMode::Default, 200, None),
+            (RetryDelayMode::Capped, 200, Some(200)),
+            (RetryDelayMode::Fixed, 200, Some(-200)),
+            (RetryDelayMode::Fixed, 0, Some(0)),
+        ] {
+            let settings = CustomRetrySettings {
+                retry_delay_mode: mode,
+                retry_delay_ms: millis,
+            };
+            std::fs::write(
+                home.path().join("custom.toml"),
+                toml::to_string(&settings).unwrap(),
+            )?;
+            assert_eq!(
+                CustomRetrySettings::load(home.path())?.signed_delay(),
+                expected
+            );
+        }
+        std::fs::write(home.path().join("custom.toml"), "retry_delay_ms = -1")?;
+        assert!(CustomRetrySettings::load(home.path()).is_err());
+        std::fs::write(
+            home.path().join("custom.toml"),
+            "retry_delay_mode = 'invalid'",
+        )?;
+        assert!(CustomRetrySettings::load(home.path()).is_err());
+        Ok(())
+    }
+}
