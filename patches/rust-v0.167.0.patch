+#[test]
+fn retry_configuration_keeps_defaults_and_unlocks_one_million() {
+    let defaults = ModelProviderInfo::default();
+    let provider = defaults.to_api_provider(None).unwrap();
+    assert_eq!(provider.retry.retry_delay_ms, None);
+    for millis in [10_000, -10_000, 0] {
+        let config = format!(
+            "retry_delay_ms = {millis}\nrequest_max_retries = 1000001\nstream_max_retries = 1000001\n"
+        );
+        let info: ModelProviderInfo = toml::from_str(&config).unwrap();
+        assert_eq!(info.request_max_retries(), 1_000_000);
+        assert_eq!(info.stream_max_retries(), 1_000_000);
