 use pretty_assertions::assert_eq;
 use std::time::Instant;
 
+#[test]
+fn space_quotes_a_selection_and_is_unhandled_without_one() {
+    let cells: Vec<Arc<dyn HistoryCell>> = vec![Arc::new(PlainHistoryCell::new(vec![
+        "selected".into(),
+        "two".into(),
+        "three".into(),
+        "four".into(),
+        "five".into(),
+        "six".into(),
+    ]))];
+    let mut view = TranscriptView::default();
+    render(&mut view, &cells, 32, 3);
+    let space = KeyEvent::new(KeyCode::Char(' '), KeyModifiers::NONE);
+    assert!(!view.owns_interaction_key(space));
+    assert!(view.handle_key(space, &cells).is_none());
+    view.begin_selection(&cells, 0, 0, 1);
+    assert!(!view.owns_interaction_key(space));
+    assert!(view.handle_key(space, &cells).is_none());
+    view.end_selection(&cells);
+    view.scroll(&cells, -3);
+    render(&mut view, &cells, 32, 3);
+    view.begin_selection(&cells, 0, 0, 3);
+    assert!(view.owns_interaction_key(space));
+    assert!(
+        matches!(view.handle_key(space, &cells), Some(ViewAction::Quote(text)) if text == "selected")
+    );
+    let position = view.position;
+    view.end_selection(&cells);
+    assert_eq!(view.position, position);
+    assert!(view.selection.is_none());
+}
