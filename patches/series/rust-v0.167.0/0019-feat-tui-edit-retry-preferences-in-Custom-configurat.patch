+#[tokio::test]
+async fn custom_retry_saves_official_count_and_independent_delay() -> Result<()> {
+    use crate::config_panel::custom::CustomRetryEdit;
+    use crate::legacy_core::custom_retry::CustomRetrySettings;
+    use crate::legacy_core::custom_retry::RetryDelayMode;
+
+    let home = tempfile::tempdir()?;
+    let path = home.path().join("config.toml");
+    std::fs::write(
+        &path,
+        "# keep this comment\n[model_providers.openai]\nstream_max_retries = 2\n[model_providers.other]\nstream_max_retries = 7\n",
+    )?;
+    let mut app = Box::pin(make_test_app()).await;
+    app.local_settings.codex_home = AbsolutePathBuf::from_absolute_path(home.path())?;
+    app.local_settings.user_config_path = AbsolutePathBuf::from_absolute_path(&path)?;
+    app.save_custom_retry(CustomRetryEdit::StreamRetries {
+        provider_id: "openai".into(),
+        count: Some(1_000_000),
+    })
+    .await;
+    let source = std::fs::read_to_string(&path)?;
+    assert!(source.contains("# keep this comment"));
+    let config: toml::Value = toml::from_str(&source)?;
+    assert_eq!(
+        config["model_providers"]["openai"]["stream_max_retries"].as_integer(),
+        Some(1_000_000)
+    );
+    assert_eq!(
+        config["model_providers"]["other"]["stream_max_retries"].as_integer(),
+        Some(7)
+    );
+    app.save_custom_retry(CustomRetryEdit::DelayMode(RetryDelayMode::Fixed))
+        .await;
+    app.save_custom_retry(CustomRetryEdit::DelayMillis(0)).await;
+    assert_eq!(
+        CustomRetrySettings::load(home.path())?.signed_delay(),
+        Some(0)
+    );
+    assert_eq!(std::fs::read_to_string(&path)?, source);
+    app.save_custom_retry(CustomRetryEdit::StreamRetries {
+        provider_id: "openai".into(),
+        count: None,
+    })
+    .await;
+    let reset: toml::Value = toml::from_str(&std::fs::read_to_string(&path)?)?;
+    assert!(
+        reset["model_providers"]["openai"]
+            .get("stream_max_retries")
+            .is_none()
+    );
+    assert!(
+        reset["model_providers"]["other"]
+            .get("stream_max_retries")
+            .is_some()
+    );
+    Ok(())
+}
