+    pub(super) async fn save_custom_retry(
+        &mut self,
+        edit: crate::config_panel::custom::CustomRetryEdit,
+    ) {
+        use crate::config_panel::custom::CustomRetryEdit;
+        use crate::legacy_core::config::edit::ConfigEdit;
+        use crate::legacy_core::custom_retry::CustomRetrySettings;
+        use crate::legacy_core::custom_retry::RetryDelayMode;
+
+        let result: std::io::Result<()> = async {
+            let (path, edits) = match edit {
+                CustomRetryEdit::StreamRetries { provider_id, count } => {
+                    if count.is_some_and(|count| count > 1_000_000) {
+                        return Err(std::io::Error::other(
+                            "Stream retries must be between 0 and 1000000",
+                        ));
+                    }
+                    let segments = vec![
+                        "model_providers".into(),
+                        provider_id,
+                        "stream_max_retries".into(),
+                    ];
+                    let edit = match count {
+                        Some(count) => ConfigEdit::SetPath {
+                            segments,
+                            value: toml_edit::value(count as i64),
+                        },
+                        None => ConfigEdit::ClearPath { segments },
+                    };
+                    (
+                        self.local_settings.user_config_path.to_path_buf(),
+                        vec![edit],
+                    )
+                }
+                edit => {
+                    let home = self.local_settings.codex_home.as_path();
+                    let mut settings = CustomRetrySettings::load(home)?;
+                    match edit {
+                        CustomRetryEdit::DelayMode(mode) => settings.retry_delay_mode = mode,
+                        CustomRetryEdit::DelayMillis(millis) => settings.retry_delay_ms = millis,
+                        CustomRetryEdit::StreamRetries { .. } => unreachable!(),
+                    }
+                    settings.validate()?;
+                    let mode = match settings.retry_delay_mode {
+                        RetryDelayMode::Default => "default",
+                        RetryDelayMode::Capped => "capped",
+                        RetryDelayMode::Fixed => "fixed",
+                    };
+                    (
+                        home.join("custom.toml"),
+                        vec![
+                            ConfigEdit::SetPath {
+                                segments: vec!["retry_delay_mode".into()],
+                                value: toml_edit::value(mode),
+                            },
+                            ConfigEdit::SetPath {
+                                segments: vec!["retry_delay_ms".into()],
+                                value: toml_edit::value(settings.retry_delay_ms as i64),
+                            },
+                        ],
+                    )
+                }
+            };
+            // 复用官方定点编辑和原子保存，保留文件中的其他字段与注释。
+            ConfigEditsBuilder::for_config_path(&path)
+                .with_edits(edits)
+                .apply()
+                .await
+                .map_err(std::io::Error::other)
+        }
+        .await;
+        let notice = match result {
+            Ok(()) => "Saved · applies next turn".into(),
+            Err(error) => format!("Could not save: {error}"),
+        };
+        self.chat_widget.refresh_config_panel(Some(notice));
+    }
