+#[tokio::test]
+async fn transcript_quote_cursor_boundaries_and_repeated_quotes() {
+    for (draft, left, prefix, suffix) in [
+        ("前文后文", 2, "前文", "后文"),
+        ("后文", 2, "", "后文"),
+        ("前文", 0, "前文", ""),
+        ("", 0, "", ""),
+    ] {
+        let (mut app, _, mut operations) = make_test_app_with_channels().await;
+        app.chat_widget.apply_external_edit(draft.into());
+        for _ in 0..left {
+            app.chat_widget.handle_key_event(KeyCode::Left.into());
+        }
+        app.chat_widget.append_transcript_quote("引用");
+        assert_eq!(
+            app.chat_widget.composer_text_with_pending(),
+            format!("{prefix}\n> 引用\n\n{suffix}")
+        );
+        app.chat_widget.append_transcript_quote("再次引用");
+        app.chat_widget.insert_str("继续");
+        assert_eq!(
+            app.chat_widget.composer_text_with_pending(),
+            format!("{prefix}\n> 引用\n\n> 再次引用\n继续\n\n{suffix}")
+        );
+        assert!(operations.try_recv().is_err());
+    }
 }
 
