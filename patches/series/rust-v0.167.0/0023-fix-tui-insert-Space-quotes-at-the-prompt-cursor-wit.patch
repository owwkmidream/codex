     for (draft, pasted, expected) in [
diff --git a/codex-rs/tui/src/bottom_pane/chat_composer/paste_input.rs b/codex-rs/tui/src/bottom_pane/chat_composer/paste_input.rs
index efb2a0bc8578cf0762f548fca20df253afa78b73..612c04a37fe58eff50c6636fa1c9167c5d8fd812 100644
--- a/codex-rs/tui/src/bottom_pane/chat_composer/paste_input.rs
+++ b/codex-rs/tui/src/bottom_pane/chat_composer/paste_input.rs
@@ -12,6 +12,23 @@ use crate::bottom_pane::paste_burst::FlushResult;
 use crate::bottom_pane::textarea::EditTarget;
 
 impl ChatComposer {
+    pub(crate) fn insert_transcript_quote(&mut self, text: &str) {
+        self.flush_pending_paste_burst();
+        self.dismiss_sparkle();
+        let started_vim_edit = self.begin_direct_vim_edit();
+        let cursor = self.draft.textarea.cursor();
+        // 直接插入以保留后文及元素 ID，避开选区替换和 Vim Replace。
+        self.draft
+            .textarea
+            .insert_str_at(cursor, &format!("{text}\n"));
+        // 引用后的空行用于继续输入，原后文从下一行开始。
+        self.draft.textarea.set_cursor(cursor + text.len());
+        self.sync_popups();
+        if started_vim_edit {
+            self.finish_vim_edit();
+        }
+    }
+
     pub(crate) fn insert_str(&mut self, text: &str) {
         self.insert_str_at_target(self.draft.textarea.edit_target(), text);
     }
