From: owwkmidream <159dreaml@gmail.com>
Date: Mon, 9 Nov 2026 05:19:08 +0800
Subject: [PATCH] fix(progress): exclude byte progress from realtime text

---
 codex-rs/core/src/session/turn.rs       |  1 +
 codex-rs/core/src/session/turn_tests.rs | 19 +++++++++++++++++++
 2 files changed, 20 insertions(+)

diff --git a/codex-rs/core/src/session/turn.rs b/codex-rs/core/src/session/turn.rs
index ce65d6bb25b8903a6d8b6e1ef1b75471be059485..232ce430ad6a6256d4030152f9ad2ae97e9cb22e 100644
--- a/codex-rs/core/src/session/turn.rs
+++ b/codex-rs/core/src/session/turn.rs
@@ -2319,6 +2319,7 @@ pub(super) fn realtime_text_for_event(msg: &EventMsg) -> Option<RealtimeEventTex
         | EventMsg::RealtimeConversationClosed(_)
         | EventMsg::ModelReroute(_)
         | EventMsg::ModelVerification(_)
+        | EventMsg::ModelRequestProgress(_)
         | EventMsg::TurnModerationMetadata(_)
         | EventMsg::SafetyBuffering(_)
         | EventMsg::ContextCompacted(_)
diff --git a/codex-rs/core/src/session/turn_tests.rs b/codex-rs/core/src/session/turn_tests.rs
index c1554d79c0241e43f59cb02e9ca62f8811f66ddb..ccd25aaf1e3550d9474e4089ba128a5fc7ed0a06 100644
--- a/codex-rs/core/src/session/turn_tests.rs
+++ b/codex-rs/core/src/session/turn_tests.rs
@@ -94,6 +94,25 @@ async fn plan_mode_uses_contributed_turn_item_for_last_agent_message() {
     );
 }
 
+#[test]
+fn realtime_model_request_progress_has_no_text() {
+    use codex_protocol::protocol::ModelRequestProgressEvent;
+    use codex_protocol::protocol::ModelRequestProgressPhase;
+
+    // 收发进度只更新 UI，不转成实时对话文本。
+    for phase in [
+        ModelRequestProgressPhase::Sending,
+        ModelRequestProgressPhase::Receiving,
+    ] {
+        let event = EventMsg::ModelRequestProgress(ModelRequestProgressEvent {
+            phase,
+            sent_bytes: 128,
+            received_bytes: 256,
+        });
+        assert_eq!(realtime_text_for_event(&event), None);
+    }
+}
+
 #[test]
