+pub(crate) fn open_link(destination: &str) -> std::io::Result<()> {
+    #[cfg(windows)]
+    if let Some(script) = editor_launch_script(destination) {
+        use std::os::windows::process::CommandExt;
+
+        // 编辑器 URI 必须交给系统协议处理器，不能强制传给浏览器。
+        let output = std::process::Command::new("powershell.exe")
+            .creation_flags(0x08000000) // CREATE_NO_WINDOW
+            .args(["-NoProfile", "-NonInteractive", "-Command", &script])
+            .output()?;
+        return if output.status.success() {
+            Ok(())
+        } else {
+            Err(std::io::Error::other(
+                String::from_utf8_lossy(&output.stderr).into_owned(),
+            ))
+        };
+    }
+    webbrowser::open(destination)
+}
+
+#[cfg(any(windows, test))]
+fn editor_launch_script(destination: &str) -> Option<String> {
+    let destination = editor_destination(destination)?;
+    Some(format!(
+        "$ErrorActionPreference = 'Stop'; Start-Process -FilePath '{}'",
+        destination.replace('\'', "''")
+    ))
+}
+
+#[test]
+fn editor_links_launch_registered_protocol_and_quote_paths() {
+    for scheme in ["vscode", "vscode-insiders", "windsurf", "cursor"] {
+        let uri = format!("{scheme}://file/C:/O'Brien/a%20b.rs:19:3");
+        let script = editor_launch_script(&uri).expect("editor protocol");
+        assert!(script.contains(&format!(
+            "Start-Process -FilePath '{scheme}://file/C:/O''Brien/a%20b.rs:19:3'"
+        )));
+    }
+    for uri in [
+        "https://example.com",
+        "file:///C:/a.rs",
+        "vscode://command/run",
+        "vscode://file/C:/a.rs?command=run",
+    ] {
+        assert_eq!(editor_launch_script(uri), None);
+    }
+}
