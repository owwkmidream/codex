From fe66fd5eb733e8e9aa9f48f1d1087872656a7ef0 Mon Sep 17 00:00:00 2001
From: owwkmidream <159dreaml@gmail.com>
Date: Mon, 9 Nov 2026 18:24:54 +0800
Subject: [PATCH] fix(tui): use widget APIs across module boundaries

---
 codex-rs/tui/src/app/session_lifecycle.rs        |  2 +-
 .../tui/src/app/tests/transcript_selection.rs    | 16 ++++++++--------
 2 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/codex-rs/tui/src/app/session_lifecycle.rs b/codex-rs/tui/src/app/session_lifecycle.rs
index de535ad6a51a8d577731ab05cf39e92fda22e78f..32a82d9977cccc964f4f7f546f85322f15ca3253 100644
--- a/codex-rs/tui/src/app/session_lifecycle.rs
+++ b/codex-rs/tui/src/app/session_lifecycle.rs
@@ -535,7 +535,7 @@ impl App {
         }
         chat_widget.restore_kill_buffer_snapshot(self.chat_widget.take_kill_buffer_snapshot());
         crate::markdown_render::preferences::init(chat_widget.local_settings.tui.rendering);
-        crate::markdown_render::preferences::init_file_opener(chat_widget.config.file_opener);
+        crate::markdown_render::preferences::init_file_opener(chat_widget.config_ref().file_opener);
         let mut previous = std::mem::replace(&mut self.chat_widget, chat_widget);
         if previous.realtime_conversation_is_running() {
             previous.park_voice();
diff --git a/codex-rs/tui/src/app/tests/transcript_selection.rs b/codex-rs/tui/src/app/tests/transcript_selection.rs
index c4f321c57cb3dd654b5204b16710e8207dc3d834..16753cb3e2f0cc7883ac832cab5256923cb74ccf 100644
--- a/codex-rs/tui/src/app/tests/transcript_selection.rs
+++ b/codex-rs/tui/src/app/tests/transcript_selection.rs
@@ -16,16 +16,16 @@ async fn quote_appends_to_draft_tail_and_preserves_attachments() {
             mention_bindings: Vec::new(),
         });
     app.chat_widget.handle_key_event(KeyCode::Left.into());
-    let mut expected = app.chat_widget.capture_thread_input_state().unwrap();
-    expected
-        .composer
-        .as_mut()
-        .unwrap()
-        .text
-        .push_str("\n> 引用\n> \n>   第二行\n> \n");
     app.chat_widget
         .append_transcript_quote("引用\n\n  第二行\n");
-    assert_eq!(app.chat_widget.capture_thread_input_state(), Some(expected));
+    assert_eq!(
+        app.chat_widget.composer_text_with_pending(),
+        "draft\n> 引用\n> \n>   第二行\n> \n"
+    );
+    assert_eq!(
+        app.chat_widget.remote_image_urls(),
+        vec!["https://example.com/image.png".to_string()]
+    );
     assert!(operations.try_recv().is_err());
 }
 
