 use pretty_assertions::assert_eq;
 
+#[tokio::test]
+async fn esc_restores_only_turns_without_answer_or_tool_output() {
+    for tool_completed in [false, true] {
+        let (mut chat, mut events, mut operations) = make_chatwidget_manual(None).await;
+        chat.thread_id = Some(ThreadId::new());
+        chat.submit_user_message(UserMessage::from("prompt"));
+        let _ = next_submit_op(&mut operations);
+        handle_turn_started(&mut chat, "turn-1");
+        if tool_completed {
+            let mut item =
+                begin_unified_exec_startup(&mut chat, "call-1", "process-1", "echo done");
+            if let AppServerThreadItemPayload::CommandExecution { status, .. } = &mut item {
+                *status = AppServerCommandExecutionStatus::Completed;
+            }
+            chat.handle_server_notification(
+                ServerNotification::ItemCompleted(ItemCompletedNotification::new(
+                    chat.thread_id.unwrap().to_string(),
+                    "turn-1".into(),
+                    item,
+                    None,
+                    0,
+                )),
+                None,
+            );
+        }
+        while events.try_recv().is_ok() {}
+        chat.handle_key_event(KeyCode::Esc.into());
+        next_interrupt_op(&mut operations);
+        handle_turn_interrupted(&mut chat, "turn-1");
+        let rollback = std::iter::from_fn(|| events.try_recv().ok()).any(|event| matches!(
+            event, AppEvent::RollbackOutputFreeTurnForPromptRestore { turn_id, .. } if turn_id == "turn-1"
+        ));
+        assert_eq!(rollback, !tool_completed);
+    }
+}
