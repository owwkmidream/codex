+                        received_bytes: progress.received_bytes,
+                    },
+                ))
+                .await;
+        }
         EventMsg::TurnComplete(turn_complete_event) => {
             // All per-thread requests are bound to a turn, so abort them.
             outgoing.abort_pending_server_requests().await;
