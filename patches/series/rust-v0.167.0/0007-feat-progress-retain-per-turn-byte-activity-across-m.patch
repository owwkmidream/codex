+/// Direction of the byte counters in [`ModelRequestProgressNotification`].
+#[derive(Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(rename_all = "camelCase", export_to = "v2/")]
+pub enum ModelRequestProgressPhase {
+    Sending,
+    Receiving,
+}
+
+/// Ephemeral byte progress for the active upstream model request.
+///
+/// Not persisted and never replayed; clients render it as live transfer volume.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ModelRequestProgressNotification {
+    pub thread_id: String,
+    pub turn_id: String,
+    pub phase: ModelRequestProgressPhase,
+    /// Cumulative request bytes sent for this request.
+    pub sent_bytes: u64,
+    /// Cumulative response bytes received for this request.
+    pub received_bytes: u64,
+}
+
 #[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
 #[serde(rename_all = "camelCase")]
 #[ts(export_to = "v2/")]
