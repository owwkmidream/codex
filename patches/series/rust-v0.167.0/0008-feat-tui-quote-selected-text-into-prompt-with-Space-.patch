+#[tokio::test]
+async fn quote_appends_to_draft_tail_and_preserves_attachments() {
+    let (mut app, _, mut operations) = make_test_app_with_channels().await;
+    app.chat_widget
+        .restore_user_message_to_composer(UserMessage {
+            text: "draft".into(),
+            remote_image_urls: vec!["https://example.com/image.png".into()],
+            local_images: Vec::new(),
+            text_elements: Vec::new(),
+            mention_bindings: Vec::new(),
+        });
+    app.chat_widget.handle_key_event(KeyCode::Left.into());
+    let mut expected = app.chat_widget.capture_thread_input_state().unwrap();
+    expected
+        .composer
+        .as_mut()
+        .unwrap()
+        .text
+        .push_str("\n> 引用\n第二行\n");
+    app.chat_widget.append_transcript_quote("引用\n第二行");
+    assert_eq!(app.chat_widget.capture_thread_input_state(), Some(expected));
+    assert!(operations.try_recv().is_err());
+}
