+#[tokio::test]
+async fn custom_retry_rejects_builtin_provider_without_changing_config() -> Result<()> {
+    use crate::config_panel::custom::CustomRetryEdit;
+
+    let home = tempfile::tempdir()?;
+    let path = home.path().join("config.toml");
+    let source = "# Built-in provider uses official defaults\nmodel_provider = 'openai'\n";
+    std::fs::write(&path, source)?;
+    let mut app = Box::pin(make_test_app()).await;
+    app.local_settings.codex_home = AbsolutePathBuf::from_absolute_path(home.path())?;
+    app.local_settings.user_config_path = AbsolutePathBuf::from_absolute_path(&path)?;
+    for count in [Some(42), None] {
+        app.save_custom_retry(CustomRetryEdit::StreamRetries {
+            provider_id: "openai".into(),
+            count,
+        })
+        .await;
+        assert_eq!(std::fs::read_to_string(&path)?, source);
+    }
+    Ok(())
+}
