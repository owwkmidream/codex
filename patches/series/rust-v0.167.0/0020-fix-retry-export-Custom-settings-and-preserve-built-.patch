+pub(crate) fn stream_retries_editable(provider_id: &str) -> bool {
+    // 与上游内置目录保持一致，避免写出下次启动无法加载的 provider 配置。
+    !codex_model_provider_info::built_in_model_providers(None).contains_key(provider_id)
+}
