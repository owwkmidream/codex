+#[test]
+fn builtin_stream_retries_are_unavailable_while_delay_remains_editable() {
+    let mut status = STATUS;
+    for provider_id in codex_model_provider_info::built_in_model_providers(None).keys() {
+        status.custom = Some(custom::CustomRetryStatus {
+            provider_id: provider_id.clone(),
+            stream_retries: None,
+            delay: Default::default(),
+        });
+        let (tx, mut rx) = unbounded_channel();
+        let mut panel = ConfigPanel::new(
+            &Tui::default(),
+            AppEventSender::new(tx),
+            RuntimeKeymap::defaults().list,
+            status.clone(),
+        );
+        for _ in 0..5 {
+            panel.handle_key_event(KeyCode::Right.into());
+        }
+        panel.handle_key_event(KeyCode::Down.into());
+        panel.handle_key_event(KeyCode::Enter.into());
+        assert!(rx.try_recv().is_err());
+        assert!(render(&panel, 140).contains("Use a custom provider"));
+        panel.handle_key_event(KeyCode::Up.into());
+        panel.handle_key_event(KeyCode::Enter.into());
+        assert!(matches!(
+            rx.try_recv().unwrap(),
+            AppEvent::OpenConfigEditor(_)
+        ));
+    }
+}
