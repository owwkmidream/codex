+#[test]
+fn local_links_streaming_matches_full_render_and_snapshots_cwd() {
+    use crate::markdown_render::{
+        ListSpacing, render_markdown_lines_with_width_cwd_and_hidden_link_destinations as render,
+        render_streaming_markdown_lines_with_width_and_cwd as stream,
+    };
+    let markdown = "See [**SKILL.md:19**](./SKILL.md:19).\n\nNext.";
+    let cwd = Path::new("C:/project");
+    for width in [8, 40] {
+        for end in 1..=markdown.len() {
+            let input = &markdown[..end];
+            assert_eq!(
+                stream(
+                    input,
+                    Some(width),
+                    Some(cwd),
+                    &|_| true,
+                    ListSpacing::AfterMultiline
+                )
+                .lines,
+                render(input, Some(width), Some(cwd), &|_| true)
+            );
+        }
+    }
+    let old = render(markdown, None, Some(cwd), &|_| true);
+    let new = render(markdown, None, Some(Path::new("D:/other")), &|_| true);
+    assert!(
+        old.iter()
+            .flat_map(|line| &line.hyperlinks)
+            .all(|link| link.destination.contains("/C:/project/"))
+    );
+    assert!(
+        new.iter()
+            .flat_map(|line| &line.hyperlinks)
+            .all(|link| link.destination.contains("/D:/other/"))
+    );
+}
