+    let markdown = "[name](C:/project/file.md:19)";
+    let fallback = render(markdown, None, Some(Path::new("C:/project")), &|_| false);
+    assert!(fallback[0].line.to_string().contains("file.md:19"));
+    assert!(fallback.iter().all(|line| line.hyperlinks.is_empty()));
+    let previous = preferences::file_opener();
+    preferences::init_file_opener(UriBasedFileOpener::None);
