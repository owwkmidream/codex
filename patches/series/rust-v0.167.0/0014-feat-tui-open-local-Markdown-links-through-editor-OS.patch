 //! Local file-link destination parsing and display for Markdown transcripts.
 //!
-//! Local Markdown links preserve their labels. Since ordinary file destinations have no trusted
-//! navigation capability, the renderer also displays their target, shortening absolute paths
-//! relative to the session working directory when possible. This module only formats destinations;
-//! it does not resolve files or infer execution-host paths from the frontend filesystem.
+//! Local Markdown links use validated editor URIs when supported, otherwise retain a visible
+//! target. Relative targets use the session cwd; no frontend filesystem lookup is performed.
 
+use codex_config::types::UriBasedFileOpener;
 use codex_utils_path_uri::PathUri;
 use codex_utils_string::normalize_markdown_hash_location_suffix;
 use regex_lite::Regex;
@@ -38,6 +37,64 @@ pub(super) fn is_local_path_like_link(dest_url: &str) -> bool {
             [drive, b':', separator, ..]
                 if drive.is_ascii_alphabetic() && matches!(separator, b'/' | b'\\')
         )
+        || (!dest_url.is_empty()
+            && !dest_url.starts_with('#')
+            && parse_local_link_target(dest_url).is_some_and(|(path, _)| !path.contains(':')))
+}
+
+/// 仅从路径生成编辑器 URI；普通 Markdown 不能指定任意协议或命令。
+pub(super) fn editor_link_target(
+    destination: &str,
+    cwd: Option<&Path>,
+    opener: UriBasedFileOpener,
+) -> Option<(String, String)> {
+    let scheme = match opener {
+        UriBasedFileOpener::VsCode => "vscode",
+        UriBasedFileOpener::VsCodeInsiders => "vscode-insiders",
+        UriBasedFileOpener::Windsurf => "windsurf",
+        UriBasedFileOpener::Cursor => "cursor",
+        UriBasedFileOpener::None => return None,
+    };
+    if !is_local_path_like_link(destination) || destination.chars().any(char::is_control) {
+        return None;
+    }
+    let (mut path, location) = parse_local_link_target(destination)?;
+    if path.is_empty()
+        || path.starts_with("~/")
+        || path.starts_with("//")
+        || path.chars().any(char::is_control)
+    {
+        return None;
+    }
+    if !is_absolute_local_link_path(&path) {
+        let base = normalize_local_link_path_text(cwd?.to_str()?);
+        if !is_absolute_local_link_path(&base) || base.starts_with("//") {
+            return None;
+        }
+        path = format!("{base}/{path}");
+    }
+    let drive = matches!(path.as_bytes(), [d, b':', b'/', ..] if d.is_ascii_alphabetic());
+    if path[if drive { 2 } else { 0 }..].contains(':') {
+        return None;
+    }
+    if drive {
+        path.replace_range(..1, &path[..1].to_ascii_uppercase());
+    }
+    // 使用 URL 路径编码空格、中文和保留字符，并折叠相对于会话 cwd 的点路径。
+    let mut file = Url::parse("file:///").ok()?;
+    file.set_path(&if drive { format!("/{path}") } else { path }.replace('%', "%25"));
+    PathUri::parse(file.as_str()).ok()?;
+    let mut copy_target = file.to_string();
+    let mut editor = Url::parse(&format!("{scheme}://file/")).ok()?;
+    editor.set_path(file.path());
+    if let Some(location) = location {
+        copy_target.push_str(&location);
+        // 编辑器定位到范围的起点；复制保留整个范围。
+        let start = location.split(['-', '–']).next()?;
+        editor.set_path(&format!("{}{start}", editor.path()));
+    }
+    let destination = crate::terminal_hyperlinks::editor_destination(editor.as_str())?;
+    Some((destination, copy_target))
 }
 
