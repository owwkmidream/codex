+#[test]
+fn local_links_keep_short_labels_targets_and_copy_across_layouts() {
+    use crate::markdown_copy::{SelectedLine, selection};
+    use crate::markdown_render::render_markdown_lines_with_width_cwd_and_hidden_link_destinations as render;
+    let cwd = Path::new("C:/project");
+    for width in [8, 24, 80] {
+        for markdown in [
+            "[**说明 SKILL.md:19**](<./目录/SKILL.md:19>)".to_string(),
+            "| File |\n| --- |\n| [说明 SKILL.md:19](<./目录/SKILL.md:19>) |".to_string(),
+        ] {
+            let lines = render(&markdown, Some(width), Some(cwd), &|_| true);
+            let links = lines
+                .iter()
+                .flat_map(|line| &line.hyperlinks)
+                .collect::<Vec<_>>();
+            assert!(!links.is_empty());
+            assert!(
+                links
+                    .iter()
+                    .all(|link| link.terminal_destination().as_deref()
+                        == Some("vscode://file/C:/project/%E7%9B%AE%E5%BD%95/SKILL.md:19"))
+            );
+            assert!(
+                lines
+                    .iter()
+                    .all(|line| !line.line.to_string().contains("project"))
+            );
+            let mut selected = Vec::new();
+            for line in &lines {
+                if let Some(source) = &line.source {
+                    SelectedLine::append(&mut selected, source.clone(), source.range.clone(), "\n");
+                }
+            }
+            let copied = selection(&selected, "").0;
+            assert!(
+                copied.contains("file:///C:/project/%E7%9B%AE%E5%BD%95/SKILL.md:19"),
+                "{copied}"
+            );
+        }
