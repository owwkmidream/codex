+#[test]
+fn local_links_resolve_windows_spellings_and_locations() {
+    let cwd = Path::new("C:/project");
+    for target in [
+        "C:/project/src/main.rs:19:3",
+        "c:/project/src/main.rs:19:3",
+        "/C:/project/src/main.rs:19:3",
+        "/c:/project/src/main.rs:19:3",
+        r"C:\project\src\main.rs:19:3",
+        "src/main.rs:19:3",
+        "./src/main.rs#L19C3",
+        r"src\main.rs:19:3",
+        "../project/src/main.rs:19:3",
+        "file:///C:/project/src/main.rs#L19C3",
+        "file:///C:/project/src/main.rs:19:3",
+    ] {
+        let (uri, copied) =
+            editor_link_target(target, Some(cwd), UriBasedFileOpener::VsCode).unwrap();
+        assert_eq!(
+            uri.to_ascii_lowercase(),
+            "vscode://file/c:/project/src/main.rs:19:3",
+            "{target}"
+        );
+        assert_eq!(
+            editor_link_target(&copied, None, UriBasedFileOpener::VsCode)
+                .unwrap()
+                .0,
+            uri
+        );
+    }
+}
