+/// 编辑器链接只接受固定协议和 file authority，保持通用 OSC 8 的 Web 白名单。
+pub(crate) fn editor_destination(destination: &str) -> Option<String> {
+    if destination.chars().any(char::is_control) {
+        return None;
+    }
+    let safe = sanitized_destination(destination)?;
+    let url = Url::parse(&safe).ok()?;
+    (matches!(
+        url.scheme(),
+        "vscode" | "vscode-insiders" | "windsurf" | "cursor"
+    ) && url.host_str() == Some("file")
+        && url.username().is_empty()
+        && url.password().is_none()
+        && url.port().is_none()
+        && url.query().is_none()
+        && url.fragment().is_none()
+        && url.path().starts_with('/')
+        && url.path().len() > 1
+        && !urlencoding::decode(url.path())
+            .ok()?
+            .chars()
+            .any(char::is_control))
+    .then_some(safe)
+}
