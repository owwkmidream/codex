+#[test]
+fn local_links_encode_paths_and_preserve_ranges_in_copy() {
+    let (uri, copied) = editor_link_target(
+        "./目录/a%20b%2520%23.md#L19C3-L22C5",
+        Some(Path::new("/work")),
+        UriBasedFileOpener::Cursor,
+    )
+    .unwrap();
+    assert_eq!(
+        uri,
+        "cursor://file/work/%E7%9B%AE%E5%BD%95/a%20b%2520%23.md:19:3"
+    );
+    assert!(copied.ends_with(":19:3-22:5"));
+    assert_eq!(
+        editor_link_target(&copied, None, UriBasedFileOpener::Cursor)
+            .unwrap()
+            .0,
+        uri
+    );
+    for (opener, scheme) in [
+        (UriBasedFileOpener::VsCodeInsiders, "vscode-insiders"),
+        (UriBasedFileOpener::Windsurf, "windsurf"),
+    ] {
+        assert!(
+            editor_link_target("/tmp/a b.md", None, opener)
+                .unwrap()
+                .0
+                .starts_with(scheme)
+        );
+    }
+}
