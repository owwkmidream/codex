-    server_delay
-        .filter(|_| millis >= 0)
-        .unwrap_or_else(|| Duration::from_millis(millis.unsigned_abs()))
+/// 非负数限制所有来源的等待上限；负数固定等待绝对值，包含 i64::MIN。
+pub fn configured_retry_delay(millis: i64, original_delay: Duration) -> Duration {
+    let configured = Duration::from_millis(millis.unsigned_abs());
+    if millis < 0 {
+        configured
+    } else {
+        original_delay.min(configured)
+    }
 }
 
