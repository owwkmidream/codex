@@ -3,13 +3,46 @@
 
 use super::*;
 
-pub(super) const COMPACTION_HEADER: &str = "Compacting context";
 pub(super) const COMPACTION_DETAILS: &str = "Making room to continue.";
 
+/// Which compaction implementation is producing the current status banner.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(super) enum CompactionStatusKind {
+    Local,
+    RemoteV2,
+}
+
+impl CompactionStatusKind {
+    pub(super) fn header(self) -> &'static str {
+        match self {
+            Self::Local => "Compacting locally",
+            Self::RemoteV2 => "Compacting remotely",
+        }
+    }
+
+    /// Resolve the implementation from the same inputs the core turn path uses:
+    /// token-budget compaction and providers without remote support both compact locally.
+    pub(super) fn resolve(
+        features: &crate::legacy_core::config::ManagedFeatures,
+        provider: &codex_model_provider_info::ModelProviderInfo,
+    ) -> Self {
+        // 与核心复用同一能力解析，包含用户对 provider capability 的覆盖。
+        if features.enabled(Feature::TokenBudget)
+            || codex_model_provider::ProviderCapabilities::from_config(provider).remote_compaction
+                == codex_model_provider_info::RemoteCompactionSupport::Unsupported
+        {
+            Self::Local
+        } else {
+            Self::RemoteV2
+        }
+    }
+}
+
 #[derive(Debug)]
 pub(super) struct ActiveCompaction {
     pub(super) id: String,
     pub(super) started_at: Instant,
+    pub(super) kind: CompactionStatusKind,
 }
 
 impl ChatWidget {
@@ -25,10 +58,16 @@ impl ChatWidget {
         self.flush_answer_stream_with_separator();
         let now = Instant::now();
         let started_at = now.checked_sub(elapsed).unwrap_or(now);
-        self.status_state.compaction = Some(ActiveCompaction { id, started_at });
+        let kind =
+            CompactionStatusKind::resolve(&self.config.features, &self.config.model_provider);
+        self.status_state.compaction = Some(ActiveCompaction {
+            id,
+            started_at,
+            kind,
+        });
         self.bottom_pane.set_status_timer_origin(Some(started_at));
         self.bottom_pane.ensure_status_indicator();
-        self.set_status_header(COMPACTION_HEADER.to_string());
+        self.set_status_header(kind.header().to_string());
     }
 
     pub(super) fn clear_context_compaction(&mut self) {
