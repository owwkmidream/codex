+#[tokio::test]
+async fn compaction_banner_respects_provider_capability_override() {
+    use codex_model_provider_info::ModelProviderCapabilities;
+    use codex_model_provider_info::RemoteCompactionSupport;
+    let (mut chat, _, _) = make_chatwidget_manual(None).await;
+    chat.config.model_provider.capabilities = Some(ModelProviderCapabilities {
+        remote_compaction: Some(RemoteCompactionSupport::Unsupported),
+        ..Default::default()
+    });
+    chat.dispatch_command(SlashCommand::Compact);
+    assert_eq!(
+        chat.bottom_pane.status_widget().unwrap().header(),
+        "Compacting locally"
+    );
+}
