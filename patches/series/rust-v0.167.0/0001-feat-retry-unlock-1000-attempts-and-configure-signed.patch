     Duration::from_millis((raw as f64 * jitter) as u64)
 }
 
+/// 正数优先采用服务端建议；负数固定等待其绝对值，包含 i64::MIN。
+pub fn configured_retry_delay(millis: i64, server_delay: Option<Duration>) -> Duration {
+    server_delay
+        .filter(|_| millis >= 0)
+        .unwrap_or_else(|| Duration::from_millis(millis.unsigned_abs()))
+}
+
 /// Identifies a retry path and its associated trace-event layer.
 #[derive(Debug, Clone, Copy)]
 pub enum RetryOperation {
@@ -100,10 +108,17 @@ where
                     .should_retry(&err, attempt, policy.max_attempts) =>
             {
                 let retry_attempt = attempt + 1;
-                let retry_after = err.retry_after();
+                let retry_after = err
+                    .retry_after()
+                    .filter(|_| policy.retry_delay_ms.is_none_or(|millis| millis >= 0));
                 let delay = retry_after
                     .map(RetryAfter::remaining_delay)
-                    .unwrap_or_else(|| backoff(policy.base_delay, retry_attempt));
+                    .unwrap_or_else(|| {
+                        policy.retry_delay_ms.map_or_else(
+                            || backoff(policy.base_delay, retry_attempt),
+                            |millis| configured_retry_delay(millis, None),
+                        )
+                    });
                 crate::record_retry!(retry_attempt, delay, RetryOperation::HttpRequest);
                 if let Some(retry_after) = retry_after {
                     tokio::time::sleep_until(retry_after.deadline()).await;
@@ -116,3 +131,30 @@ where
     }
     Err(TransportError::RetryLimit)
 }
+
+#[cfg(test)]
+mod configured_retry_tests {
+    use super::*;
+
+    #[test]
+    fn configured_delay_obeys_sign_and_server_advice() {
+        let advice = Some(Duration::from_secs(30));
+        assert_eq!(
+            configured_retry_delay(10_000, advice),
+            Duration::from_secs(30)
+        );
+        assert_eq!(
+            configured_retry_delay(-10_000, advice),
+            Duration::from_secs(10)
+        );
+        assert_eq!(
+            configured_retry_delay(10_000, None),
+            Duration::from_secs(10)
+        );
+        assert_eq!(configured_retry_delay(0, None), Duration::ZERO);
+        assert_eq!(
+            configured_retry_delay(i64::MIN, None),
+            Duration::from_millis(1_u64 << 63)
+        );
+    }
+}
