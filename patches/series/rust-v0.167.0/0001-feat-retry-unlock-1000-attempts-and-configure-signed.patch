+#[test]
+fn retry_configuration_keeps_defaults_and_unlocks_1000() {
+    let defaults = ModelProviderInfo::default();
+    let provider = defaults.to_api_provider(None).unwrap();
+    assert_eq!(provider.retry.retry_delay_ms, Some(10_000));
+    for millis in [10_000, -10_000, 0] {
+        let config = format!(
+            "retry_delay_ms = {millis}\nrequest_max_retries = 1001\nstream_max_retries = 1001\n"
+        );
+        let info: ModelProviderInfo = toml::from_str(&config).unwrap();
+        assert_eq!(info.request_max_retries(), 1000);
+        assert_eq!(info.stream_max_retries(), 1000);
+        assert_eq!(
+            info.to_api_provider(None).unwrap().retry.retry_delay_ms,
+            Some(millis)
+        );
+    }
+    assert_eq!(defaults.request_max_retries(), DEFAULT_REQUEST_MAX_RETRIES);
+    assert_eq!(defaults.stream_max_retries(), DEFAULT_STREAM_MAX_RETRIES);
+}
