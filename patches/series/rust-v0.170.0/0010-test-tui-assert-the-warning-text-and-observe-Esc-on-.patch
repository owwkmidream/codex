From 86522c3b55b75b4a2370a91c5781304c3aa49304 Mon Sep 17 00:00:00 2001
From: Codex patches <patches@localhost>
Date: Wed, 18 Nov 2026 19:48:58 +0800
Subject: [PATCH] test(tui): assert the warning text and observe Esc on the app
 event channel

---
 codex-rs/tui/src/chatwidget/tests/app_server.rs | 3 +--
 codex-rs/tui/src/chatwidget/tests/exec_flow.rs  | 4 +++-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/codex-rs/tui/src/chatwidget/tests/app_server.rs b/codex-rs/tui/src/chatwidget/tests/app_server.rs
index 02529f87cee4f617a7d593ee3d50a6c57c58d19c..07a38a15c7c795e31d75c93e45707856b6bb1df9 100644
--- a/codex-rs/tui/src/chatwidget/tests/app_server.rs
+++ b/codex-rs/tui/src/chatwidget/tests/app_server.rs
@@ -2077,8 +2077,7 @@ async fn live_app_server_cyber_policy_warning_keeps_turn_running() {
     let cells = drain_insert_history(&mut rx);
     assert_eq!(cells.len(), 1);
     let rendered = lines_to_single_string(&cells[0]);
-    assert!(rendered.contains("This content can’t be shown"));
-    assert!(rendered.contains("We take extra care with some cybersecurity requests"));
+    assert!(rendered.contains("We take extra precaution with cybersecurity requests"));
     assert!(!rendered.contains("server fallback message"));
     // 警告保持当前轮运行，结束状态由后端的 TurnCompleted 通知推进。
     assert!(chat.bottom_pane.is_task_running());
diff --git a/codex-rs/tui/src/chatwidget/tests/exec_flow.rs b/codex-rs/tui/src/chatwidget/tests/exec_flow.rs
index de6309c300c6895b39065f50708b31251dcd19fc..700e69ba9d0b67f7d43b75e6f07f4060d4bea78f 100644
--- a/codex-rs/tui/src/chatwidget/tests/exec_flow.rs
+++ b/codex-rs/tui/src/chatwidget/tests/exec_flow.rs
@@ -29,7 +29,9 @@ async fn esc_restores_only_turns_without_answer_or_tool_output() {
         }
         while events.try_recv().is_ok() {}
         chat.handle_key_event(KeyCode::Esc.into());
-        next_interrupt_op(&mut operations);
+        let interrupted = std::iter::from_fn(|| events.try_recv().ok())
+            .any(|event| matches!(event, AppEvent::CodexOp(Op::Interrupt)));
+        assert!(interrupted);
         handle_turn_interrupted(&mut chat, "turn-1");
         let rollback = std::iter::from_fn(|| events.try_recv().ok()).any(|event| matches!(
             event, AppEvent::RollbackOutputFreeTurnForPromptRestore { turn_id, .. } if turn_id == "turn-1"
