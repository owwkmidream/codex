--- a/codex-rs/codex-client/src/retry.rs
+++ b/codex-rs/codex-client/src/retry.rs
@@ -9,6 +9,7 @@ use std::time::Duration;
 pub struct RetryPolicy {
     pub max_attempts: u64,
     pub base_delay: Duration,
+    pub retry_delay_ms: Option<i64>,
     pub retry_on: RetryOn,
 }
 
@@ -51,6 +52,16 @@ pub fn backoff(base: Duration, attempt: u64) -> Duration {
     Duration::from_millis((raw as f64 * jitter) as u64)
 }
 
+/// 非负数限制所有来源的等待上限；负数固定等待绝对值，包含 i64::MIN。
+pub fn configured_retry_delay(millis: i64, original_delay: Duration) -> Duration {
+    let configured = Duration::from_millis(millis.unsigned_abs());
+    if millis < 0 {
+        configured
+    } else {
+        original_delay.min(configured)
+    }
+}
+
 /// Identifies a retry path and its associated trace-event layer.
 #[derive(Debug, Clone, Copy)]
 pub enum RetryOperation {
@@ -104,8 +115,11 @@ where
                 let delay = retry_after
                     .map(RetryAfter::remaining_delay)
                     .unwrap_or_else(|| backoff(policy.base_delay, retry_attempt));
+                let delay = policy
+                    .retry_delay_ms
+                    .map_or(delay, |millis| configured_retry_delay(millis, delay));
                 crate::record_retry!(retry_attempt, delay, RetryOperation::HttpRequest);
-                if let Some(retry_after) = retry_after {
+                if let Some(retry_after) = retry_after.filter(|_| policy.retry_delay_ms.is_none()) {
                     tokio::time::sleep_until(retry_after.deadline()).await;
                 } else {
                     tokio::time::sleep(delay).await;
@@ -116,3 +130,30 @@ where
     }
     Err(TransportError::RetryLimit)
 }
+
+#[cfg(test)]
+mod configured_retry_tests {
+    use super::*;
+
+    #[test]
+    fn configured_delay_obeys_sign_and_server_advice() {
+        let advice = Duration::from_secs(30);
+        assert_eq!(
+            configured_retry_delay(10_000, advice),
+            Duration::from_secs(10)
+        );
+        assert_eq!(
+            configured_retry_delay(-10_000, advice),
+            Duration::from_secs(10)
+        );
+        assert_eq!(
+            configured_retry_delay(10_000, Duration::from_millis(200)),
+            Duration::from_millis(200)
+        );
+        assert_eq!(configured_retry_delay(0, advice), Duration::ZERO);
+        assert_eq!(
+            configured_retry_delay(i64::MIN, Duration::ZERO),
+            Duration::from_millis(1_u64 << 63)
+        );
+    }
+}
