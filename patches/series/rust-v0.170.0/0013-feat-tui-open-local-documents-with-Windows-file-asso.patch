 pub(crate) fn open_link(destination: &str) -> std::io::Result<()> {
+    #[cfg(windows)]
+    if Path::new(destination).is_absolute() {
+        use std::os::windows::ffi::OsStrExt;
+        use windows_sys::Win32::UI::Shell::ShellExecuteW;
+        use windows_sys::Win32::UI::WindowsAndMessaging::SW_SHOWNORMAL;
+        let path = Path::new(destination);
+        if Url::from_file_path(path)
+            .ok()
+            .as_ref()
+            .and_then(system_document_url)
+            .is_none()
+        {
+            return Err(std::io::Error::other("Could not open this local document"));
+        }
+        let file: Vec<u16> = path
+            .as_os_str()
+            .encode_wide()
+            .chain(std::iter::once(0))
+            .collect();
+        // SAFETY: file is NUL-terminated and lives through the ShellExecuteW call.
+        let status = unsafe {
+            ShellExecuteW(
+                std::ptr::null_mut(),
+                std::ptr::null(),
+                file.as_ptr(),
+                std::ptr::null(),
+                std::ptr::null(),
+                SW_SHOWNORMAL,
+            )
+        } as isize;
+        return if status > 32 {
+            Ok(())
+        } else {
+            Err(std::io::Error::other(format!(
+                "Windows could not open {destination} (ShellExecuteW {status})"
+            )))
+        };
+    }
     #[cfg(windows)]
     if let Some(script) = editor_launch_script(destination) {
         use std::os::windows::process::CommandExt;
