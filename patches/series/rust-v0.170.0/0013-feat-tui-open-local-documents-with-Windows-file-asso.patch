+#[test]
+#[cfg(windows)]
+fn local_links_system_opens_native_document_and_copies_location() {
+    use super::super::preferences;
+    use crate::markdown_render::render_markdown_lines_with_width_cwd_and_hidden_link_destinations as render;
+    let directory = tempfile::tempdir().unwrap();
+    let previous = preferences::file_opener();
+    preferences::init_file_opener(UriBasedFileOpener::System);
+    for name in ["中文 report.md", "O'Brien.html"] {
+        let file = directory.path().join(name);
+        std::fs::write(&file, "").unwrap();
+        let uri = url::Url::from_file_path(&file).unwrap();
+        let (destination, copy) =
+            editor_link_target(&format!("{uri}#L4C2"), None, UriBasedFileOpener::System).unwrap();
+        let terminal_uri = url::Url::parse(&destination).unwrap();
+        assert_eq!(terminal_uri.to_file_path().unwrap(), file);
+        assert_eq!(copy, format!("{destination}:4:2"));
+        let markdown = format!("[doc](<./{name}#L4C2>)");
+        let lines = render(&markdown, Some(80), Some(directory.path()), &|_| true);
+        let link = &lines[0].hyperlinks[0];
+        assert_eq!(
+            link.terminal_destination().as_deref(),
+            Some(destination.as_str())
+        );
+        assert_eq!(link.click_destination().as_deref(), file.to_str());
+    }
+    for name in ["run.exe", "run.cmd", "go.lnk"] {
+        std::fs::write(directory.path().join(name), "").unwrap();
+        assert!(
+            editor_link_target(name, Some(directory.path()), UriBasedFileOpener::System).is_none()
+        );
+    }
+    assert!(
+        editor_link_target(
+            "missing.md",
+            Some(directory.path()),
+            UriBasedFileOpener::System
+        )
+        .is_none()
+    );
+    preferences::init_file_opener(previous);
+}
