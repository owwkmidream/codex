+/// Only existing local documents receive a file association link in the terminal.
+pub(crate) fn system_document_url(url: &Url) -> Option<String> {
+    if url.scheme() != "file" || url.host().is_some() {
+        return None;
+    }
+    let path = url.to_file_path().ok()?;
+    let extension = path.extension()?.to_str()?.to_ascii_lowercase();
+    if !SAFE_WORKSPACE_EXTENSIONS.contains(&extension.as_str())
+        && !matches!(
+            extension.as_str(),
+            "markdown"
+                | "html"
+                | "htm"
+                | "pdf"
+                | "csv"
+                | "log"
+                | "xml"
+                | "png"
+                | "jpg"
+                | "jpeg"
+                | "gif"
+                | "webp"
+                | "docx"
+                | "xlsx"
+                | "pptx"
+        )
+    {
+        return None;
+    }
+    #[cfg(windows)]
+    {
+        use std::os::windows::fs::MetadataExt;
+        use std::path::{Component, Prefix};
+        use windows_sys::Win32::Storage::FileSystem::FILE_ATTRIBUTE_REPARSE_POINT;
+        let Some(Component::Prefix(prefix)) = path.components().next() else {
+            return None;
+        };
+        if !matches!(prefix.kind(), Prefix::Disk(_)) || !path.is_absolute() {
+            return None;
+        }
+        for ancestor in path.ancestors().collect::<Vec<_>>().into_iter().rev() {
+            if ancestor.symlink_metadata().ok()?.file_attributes() & FILE_ATTRIBUTE_REPARSE_POINT
+                != 0
+            {
+                return None;
+            }
+        }
+    }
+    path.is_file().then(|| url.to_string())
+}
