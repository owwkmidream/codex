 use crate::chatwidget::UserMessage;
 use pretty_assertions::assert_eq;
 
+#[tokio::test]
+async fn transcript_quote_inserts_at_cursor_and_preserves_attachments() {
+    let (mut app, _, mut operations) = make_test_app_with_channels().await;
+    app.chat_widget
+        .restore_user_message_to_composer(UserMessage {
+            text: "draft".into(),
+            remote_image_urls: vec!["https://example.com/image.png".into()],
+            local_images: Vec::new(),
+            text_elements: Vec::new(),
+            mention_bindings: Vec::new(),
+        });
+    app.chat_widget.handle_key_event(KeyCode::Left.into());
+    app.chat_widget
+        .append_transcript_quote("引用\n\n  第二行\n");
+    assert_eq!(
+        app.chat_widget.composer_text_with_pending(),
+        "draf\n> 引用\n> \n>   第二行\n> \n\nt"
+    );
+    assert_eq!(
+        app.chat_widget.remote_image_urls(),
+        vec!["https://example.com/image.png".to_string()]
+    );
+    assert!(operations.try_recv().is_err());
+    app.chat_widget.insert_str("继续");
+    assert_eq!(
+        app.chat_widget.composer_text_with_pending(),
+        "draf\n> 引用\n> \n>   第二行\n> \n继续\nt"
+    );
+}
+
+#[tokio::test]
+async fn transcript_quote_cursor_boundaries_and_repeated_quotes() {
+    for (draft, left, prefix, suffix) in [
+        ("前文后文", 2, "前文", "后文"),
+        ("后文", 2, "", "后文"),
+        ("前文", 0, "前文", ""),
+        ("", 0, "", ""),
+    ] {
+        let (mut app, _, mut operations) = make_test_app_with_channels().await;
+        app.chat_widget.apply_external_edit(draft.into());
+        for _ in 0..left {
+            app.chat_widget.handle_key_event(KeyCode::Left.into());
+        }
+        app.chat_widget.append_transcript_quote("引用");
+        assert_eq!(
+            app.chat_widget.composer_text_with_pending(),
+            format!("{prefix}\n> 引用\n\n{suffix}")
+        );
+        app.chat_widget.append_transcript_quote("再次引用");
+        app.chat_widget.insert_str("继续");
+        assert_eq!(
+            app.chat_widget.composer_text_with_pending(),
+            format!("{prefix}\n> 引用\n\n> 再次引用\n继续\n\n{suffix}")
+        );
+        assert!(operations.try_recv().is_err());
+    }
+}
