+#[test]
+fn transcript_quote_user_reply_remains_outside_quote() {
+    let message = "> 123\n456";
+    let cells: Vec<Arc<dyn HistoryCell>> = vec![Arc::new(crate::history_cell::new_user_prompt(
+        message.into(),
+        Vec::new(),
+        Vec::new(),
+        Vec::new(),
+    ))];
+    let mut view = TranscriptView::default();
+    let buffer = render(&mut view, &cells, /*width*/ 40, /*height*/ 12);
+    let visible = text(&buffer);
+    let mut lines = visible.lines().skip_while(|line| !line.contains("> 123"));
+    assert!(lines.next().is_some(), "{visible}");
+    assert_eq!(lines.next().map(str::trim), Some("456"));
+    view.begin_copy_mode(&cells, /*guard*/ None);
+    assert_eq!(payload(&mut view, &cells).trim_end(), "> 123");
+    view.move_copy_target(&cells, KeyCode::Up);
+    assert_eq!(payload(&mut view, &cells), message);
+}
