+/// Keep lines following a user's explicit quote outside the quote in rich history.
+pub(crate) fn user_markdown_sections(input: &str) -> Vec<&str> {
+    if !input.contains('>') {
+        return vec![input];
+    }
+    let mut sections = Vec::new();
+    let mut start = 0;
+    let mut quote_end = 0;
+    for (event, span) in pulldown_cmark::Parser::new(input).into_offset_iter() {
+        if !matches!(event, Event::Start(Tag::BlockQuote)) || span.start < quote_end {
+            continue;
+        }
+        quote_end = span.end;
+        let mut offset = span.start;
+        let mut quoted = false;
+        for line in input[span].split_inclusive('\n') {
+            let marked = line.trim_start().starts_with('>');
+            if quoted && !marked && !line.trim().is_empty() {
+                sections.push(&input[start..offset]);
+                start = offset;
+            }
+            quoted = marked;
+            offset += line.len();
+        }
+    }
+    sections.push(&input[start..]);
+    sections
+}
