+}
+
+pub(crate) fn render_user_markdown(input: &str, width: u16) -> Vec<HyperlinkLine> {
+    let sections = user_markdown_sections(input);
+    if sections.len() == 1 {
+        return render_markdown_for_viewport(input, width);
+    }
+    let mut separated = String::with_capacity(input.len() + sections.len() - 1);
+    let mut adjacent_blocks = Vec::new();
+    for section in sections {
+        if !separated.is_empty() {
+            separated.push('\n');
+            adjacent_blocks.push(separated.len() + section.len() - section.trim_start().len());
+        }
+        separated.push_str(section);
+    }
+    viewport_rows(
+        &separated,
+        width,
+        ListSpacing::AfterMultiline,
+        &adjacent_blocks,
+    )
+}
